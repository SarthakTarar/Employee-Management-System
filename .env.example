# Copy this file to .env for local development and fill in real values
# for production (set these as Environment Variables in the Vercel dashboard
# instead of committing a .env file there).

SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# Postgres connection string from Neon (production). Leave unset locally to
# fall back to db.sqlite3.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# DATABASE_SSL_REQUIRE=True
